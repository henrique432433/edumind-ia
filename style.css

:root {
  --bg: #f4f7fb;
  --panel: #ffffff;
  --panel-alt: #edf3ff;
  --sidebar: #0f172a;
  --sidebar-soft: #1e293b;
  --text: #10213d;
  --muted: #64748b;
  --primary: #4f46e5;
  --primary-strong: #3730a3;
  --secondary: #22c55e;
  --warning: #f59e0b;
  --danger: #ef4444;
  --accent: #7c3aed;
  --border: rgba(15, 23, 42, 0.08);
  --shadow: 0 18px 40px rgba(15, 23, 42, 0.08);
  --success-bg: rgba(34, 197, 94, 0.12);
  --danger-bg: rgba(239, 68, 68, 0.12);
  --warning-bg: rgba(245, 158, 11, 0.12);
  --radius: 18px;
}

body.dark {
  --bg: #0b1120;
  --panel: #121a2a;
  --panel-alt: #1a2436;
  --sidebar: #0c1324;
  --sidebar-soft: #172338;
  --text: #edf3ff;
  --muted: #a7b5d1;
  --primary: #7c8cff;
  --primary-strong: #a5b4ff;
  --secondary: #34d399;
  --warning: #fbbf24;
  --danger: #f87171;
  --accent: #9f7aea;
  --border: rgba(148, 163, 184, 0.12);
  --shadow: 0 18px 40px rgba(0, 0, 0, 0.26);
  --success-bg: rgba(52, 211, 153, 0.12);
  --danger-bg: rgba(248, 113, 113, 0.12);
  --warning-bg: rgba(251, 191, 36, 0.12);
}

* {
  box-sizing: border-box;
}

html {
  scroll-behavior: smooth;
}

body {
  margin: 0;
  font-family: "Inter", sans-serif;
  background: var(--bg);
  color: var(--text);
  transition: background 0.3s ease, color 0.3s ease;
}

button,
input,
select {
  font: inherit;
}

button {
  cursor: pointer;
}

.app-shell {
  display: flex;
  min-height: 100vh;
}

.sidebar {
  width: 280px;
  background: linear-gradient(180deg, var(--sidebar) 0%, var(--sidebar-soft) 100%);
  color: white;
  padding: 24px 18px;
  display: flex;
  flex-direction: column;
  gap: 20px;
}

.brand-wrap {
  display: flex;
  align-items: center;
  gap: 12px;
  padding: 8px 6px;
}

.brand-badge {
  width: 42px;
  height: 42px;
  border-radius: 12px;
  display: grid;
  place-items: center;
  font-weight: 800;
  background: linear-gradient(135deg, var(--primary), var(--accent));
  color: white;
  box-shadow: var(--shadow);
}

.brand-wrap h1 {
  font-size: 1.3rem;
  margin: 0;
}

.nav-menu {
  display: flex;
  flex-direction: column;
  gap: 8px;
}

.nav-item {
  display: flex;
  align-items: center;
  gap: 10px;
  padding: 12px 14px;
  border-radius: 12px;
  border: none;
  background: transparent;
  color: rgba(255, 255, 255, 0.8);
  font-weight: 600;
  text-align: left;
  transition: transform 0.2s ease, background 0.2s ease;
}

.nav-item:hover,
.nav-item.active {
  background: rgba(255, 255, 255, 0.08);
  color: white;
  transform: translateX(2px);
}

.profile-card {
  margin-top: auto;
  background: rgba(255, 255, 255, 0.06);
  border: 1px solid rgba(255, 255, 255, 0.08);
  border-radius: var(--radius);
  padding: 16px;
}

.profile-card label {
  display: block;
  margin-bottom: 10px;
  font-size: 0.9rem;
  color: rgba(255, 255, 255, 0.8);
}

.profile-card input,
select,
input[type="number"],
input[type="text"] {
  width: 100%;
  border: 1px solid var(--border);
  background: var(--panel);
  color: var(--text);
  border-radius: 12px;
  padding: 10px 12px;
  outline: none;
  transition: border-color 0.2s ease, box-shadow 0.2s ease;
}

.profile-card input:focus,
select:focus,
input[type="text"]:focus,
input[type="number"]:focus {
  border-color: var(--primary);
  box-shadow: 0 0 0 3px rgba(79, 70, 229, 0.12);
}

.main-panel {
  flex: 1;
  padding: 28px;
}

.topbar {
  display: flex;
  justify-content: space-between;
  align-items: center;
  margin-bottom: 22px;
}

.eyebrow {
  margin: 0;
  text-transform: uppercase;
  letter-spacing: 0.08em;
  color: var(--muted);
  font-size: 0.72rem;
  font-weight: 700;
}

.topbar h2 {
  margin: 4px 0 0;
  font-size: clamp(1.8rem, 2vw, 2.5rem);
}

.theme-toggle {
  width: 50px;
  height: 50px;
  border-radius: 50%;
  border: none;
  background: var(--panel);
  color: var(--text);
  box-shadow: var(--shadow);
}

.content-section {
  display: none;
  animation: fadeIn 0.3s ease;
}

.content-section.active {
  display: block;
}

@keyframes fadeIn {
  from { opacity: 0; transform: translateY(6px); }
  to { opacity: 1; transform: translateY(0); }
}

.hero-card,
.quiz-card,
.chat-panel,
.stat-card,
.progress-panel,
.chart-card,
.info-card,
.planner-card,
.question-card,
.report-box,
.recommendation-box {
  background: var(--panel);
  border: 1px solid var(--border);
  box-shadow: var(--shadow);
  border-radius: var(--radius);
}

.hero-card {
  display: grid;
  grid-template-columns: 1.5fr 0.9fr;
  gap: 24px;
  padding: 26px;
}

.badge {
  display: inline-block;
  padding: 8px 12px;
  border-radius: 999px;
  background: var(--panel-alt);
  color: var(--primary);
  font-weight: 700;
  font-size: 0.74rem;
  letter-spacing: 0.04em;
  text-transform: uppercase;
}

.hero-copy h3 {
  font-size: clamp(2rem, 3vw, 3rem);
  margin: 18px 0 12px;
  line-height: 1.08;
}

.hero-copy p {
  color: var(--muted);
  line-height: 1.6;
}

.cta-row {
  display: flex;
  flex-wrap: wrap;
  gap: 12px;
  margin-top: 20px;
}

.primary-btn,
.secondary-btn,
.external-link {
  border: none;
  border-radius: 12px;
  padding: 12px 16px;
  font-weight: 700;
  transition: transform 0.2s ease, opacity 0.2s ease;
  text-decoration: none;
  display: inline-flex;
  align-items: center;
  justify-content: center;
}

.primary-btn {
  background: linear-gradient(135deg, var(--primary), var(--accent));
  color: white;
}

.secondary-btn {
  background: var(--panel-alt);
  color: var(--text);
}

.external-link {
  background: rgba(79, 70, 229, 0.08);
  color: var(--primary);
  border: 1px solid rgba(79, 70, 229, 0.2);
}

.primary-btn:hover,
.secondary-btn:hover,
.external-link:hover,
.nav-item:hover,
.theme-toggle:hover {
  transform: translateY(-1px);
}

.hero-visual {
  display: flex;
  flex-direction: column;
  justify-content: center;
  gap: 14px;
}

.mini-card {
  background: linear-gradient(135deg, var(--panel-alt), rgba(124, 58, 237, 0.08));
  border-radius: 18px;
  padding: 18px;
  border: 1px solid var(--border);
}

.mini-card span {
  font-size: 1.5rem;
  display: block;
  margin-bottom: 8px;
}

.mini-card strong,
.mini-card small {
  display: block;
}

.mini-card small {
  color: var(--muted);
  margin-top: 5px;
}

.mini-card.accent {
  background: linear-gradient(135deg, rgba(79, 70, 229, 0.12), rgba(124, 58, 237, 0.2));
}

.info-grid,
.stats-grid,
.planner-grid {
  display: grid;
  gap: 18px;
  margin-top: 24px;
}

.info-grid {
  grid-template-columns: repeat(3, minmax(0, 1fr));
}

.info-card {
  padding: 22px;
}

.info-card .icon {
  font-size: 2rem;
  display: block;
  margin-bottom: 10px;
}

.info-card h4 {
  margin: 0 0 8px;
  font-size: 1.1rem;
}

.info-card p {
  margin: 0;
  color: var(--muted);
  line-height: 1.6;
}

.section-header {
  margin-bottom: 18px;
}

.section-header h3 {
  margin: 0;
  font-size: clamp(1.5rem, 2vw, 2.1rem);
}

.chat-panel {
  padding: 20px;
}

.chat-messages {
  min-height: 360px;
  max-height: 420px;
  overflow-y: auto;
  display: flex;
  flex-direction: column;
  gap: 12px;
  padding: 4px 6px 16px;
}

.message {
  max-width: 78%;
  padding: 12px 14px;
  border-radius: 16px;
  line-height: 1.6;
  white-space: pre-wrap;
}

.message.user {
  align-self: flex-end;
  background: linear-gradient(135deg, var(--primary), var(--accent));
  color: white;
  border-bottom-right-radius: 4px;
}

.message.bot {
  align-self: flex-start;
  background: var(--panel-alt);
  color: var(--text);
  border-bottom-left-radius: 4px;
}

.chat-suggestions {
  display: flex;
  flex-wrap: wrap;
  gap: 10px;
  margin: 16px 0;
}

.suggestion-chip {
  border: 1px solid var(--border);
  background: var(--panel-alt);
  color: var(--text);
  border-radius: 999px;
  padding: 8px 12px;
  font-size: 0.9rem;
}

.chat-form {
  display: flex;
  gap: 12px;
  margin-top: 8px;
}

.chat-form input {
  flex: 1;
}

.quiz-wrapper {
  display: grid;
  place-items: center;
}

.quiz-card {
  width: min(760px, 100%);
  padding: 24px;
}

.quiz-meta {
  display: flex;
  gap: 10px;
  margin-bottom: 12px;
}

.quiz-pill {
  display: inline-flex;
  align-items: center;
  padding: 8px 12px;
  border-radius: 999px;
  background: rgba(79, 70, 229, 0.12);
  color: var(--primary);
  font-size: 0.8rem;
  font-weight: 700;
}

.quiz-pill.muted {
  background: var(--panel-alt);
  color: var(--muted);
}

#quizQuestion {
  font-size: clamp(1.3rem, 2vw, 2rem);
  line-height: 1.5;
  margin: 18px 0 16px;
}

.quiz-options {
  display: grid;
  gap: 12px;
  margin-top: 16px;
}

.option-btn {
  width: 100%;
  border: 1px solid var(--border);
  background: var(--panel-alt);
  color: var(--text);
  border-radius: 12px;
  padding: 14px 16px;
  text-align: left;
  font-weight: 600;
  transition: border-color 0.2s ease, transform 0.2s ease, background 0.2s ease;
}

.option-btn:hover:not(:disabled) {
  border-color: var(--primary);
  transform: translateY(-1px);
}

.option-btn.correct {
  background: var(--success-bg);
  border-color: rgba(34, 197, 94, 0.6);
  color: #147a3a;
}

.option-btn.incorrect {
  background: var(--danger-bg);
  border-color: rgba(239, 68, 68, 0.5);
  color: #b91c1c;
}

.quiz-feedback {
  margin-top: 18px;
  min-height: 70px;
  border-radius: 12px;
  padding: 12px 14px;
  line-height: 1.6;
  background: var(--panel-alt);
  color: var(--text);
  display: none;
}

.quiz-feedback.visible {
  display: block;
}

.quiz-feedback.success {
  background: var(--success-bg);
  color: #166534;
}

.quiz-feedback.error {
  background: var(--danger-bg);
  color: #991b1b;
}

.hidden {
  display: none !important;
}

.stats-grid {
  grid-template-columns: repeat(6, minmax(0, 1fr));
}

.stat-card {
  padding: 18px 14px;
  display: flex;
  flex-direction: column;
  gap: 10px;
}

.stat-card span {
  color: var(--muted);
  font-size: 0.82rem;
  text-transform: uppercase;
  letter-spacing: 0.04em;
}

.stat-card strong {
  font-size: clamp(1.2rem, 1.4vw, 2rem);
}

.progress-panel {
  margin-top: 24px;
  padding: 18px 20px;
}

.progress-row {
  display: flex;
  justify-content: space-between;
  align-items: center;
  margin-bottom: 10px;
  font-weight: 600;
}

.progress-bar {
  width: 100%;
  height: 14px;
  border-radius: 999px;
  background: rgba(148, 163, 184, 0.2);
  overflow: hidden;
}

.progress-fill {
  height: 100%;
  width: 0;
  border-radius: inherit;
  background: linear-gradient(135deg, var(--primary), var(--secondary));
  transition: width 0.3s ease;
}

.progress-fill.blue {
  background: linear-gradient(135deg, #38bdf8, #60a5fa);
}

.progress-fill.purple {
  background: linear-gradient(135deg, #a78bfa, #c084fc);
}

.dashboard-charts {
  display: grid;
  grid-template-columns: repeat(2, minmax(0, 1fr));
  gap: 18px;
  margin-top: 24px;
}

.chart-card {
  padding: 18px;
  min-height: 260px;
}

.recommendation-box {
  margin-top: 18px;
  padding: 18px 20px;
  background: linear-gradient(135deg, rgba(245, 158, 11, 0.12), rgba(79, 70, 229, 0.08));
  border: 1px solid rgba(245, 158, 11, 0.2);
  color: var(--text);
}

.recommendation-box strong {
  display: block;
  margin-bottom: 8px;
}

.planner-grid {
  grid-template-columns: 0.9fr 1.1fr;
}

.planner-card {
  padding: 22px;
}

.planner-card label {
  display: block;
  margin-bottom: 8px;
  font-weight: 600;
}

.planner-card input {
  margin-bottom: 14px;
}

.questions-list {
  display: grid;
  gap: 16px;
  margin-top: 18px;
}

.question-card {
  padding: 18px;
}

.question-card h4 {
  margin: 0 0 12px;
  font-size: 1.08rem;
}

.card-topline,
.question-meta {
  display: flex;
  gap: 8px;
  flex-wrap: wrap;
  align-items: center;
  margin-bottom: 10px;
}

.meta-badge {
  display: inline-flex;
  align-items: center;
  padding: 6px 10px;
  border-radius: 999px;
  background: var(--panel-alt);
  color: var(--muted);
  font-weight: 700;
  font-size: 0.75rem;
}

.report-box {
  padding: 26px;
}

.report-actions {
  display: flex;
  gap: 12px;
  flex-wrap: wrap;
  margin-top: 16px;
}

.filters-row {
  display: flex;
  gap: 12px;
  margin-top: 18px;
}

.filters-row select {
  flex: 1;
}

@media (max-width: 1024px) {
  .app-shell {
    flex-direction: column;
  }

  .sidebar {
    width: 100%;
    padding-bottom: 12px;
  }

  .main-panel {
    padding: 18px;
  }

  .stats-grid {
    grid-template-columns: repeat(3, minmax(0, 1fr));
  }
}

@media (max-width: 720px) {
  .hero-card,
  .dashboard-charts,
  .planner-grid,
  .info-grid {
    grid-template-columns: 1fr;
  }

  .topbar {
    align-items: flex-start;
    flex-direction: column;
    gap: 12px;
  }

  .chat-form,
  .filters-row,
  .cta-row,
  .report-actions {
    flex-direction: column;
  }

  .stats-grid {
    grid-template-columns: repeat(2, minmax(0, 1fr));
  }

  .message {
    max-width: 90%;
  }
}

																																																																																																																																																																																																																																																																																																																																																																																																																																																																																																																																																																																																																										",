<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MARQIV</title>
    <meta
      name="description"
      content="MARQIV - Plataforma educacional de matemática com IA, quiz e acompanhamento de progresso."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="style.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar">
        <div class="brand-wrap">
          <div class="brand-badge">M</div>
          <div>
            <h1>MARQIV</h1>
          </div>
        </div>

        <nav class="nav-menu">
          <button class="nav-item active" data-section="home">
            <span>🏠</span> Início
          </button>
          <button class="nav-item" data-section="chat">
            <span>💬</span> Chat IA
          </button>
          <button class="nav-item" data-section="quiz">
            <span>🧠</span> Quiz
          </button>
          <button class="nav-item" data-section="dashboard">
            <span>📊</span> Dashboard
          </button>
          <button class="nav-item" data-section="planner">
            <span>🗓️</span> Meu Plano
          </button>
          <button class="nav-item" data-section="questions">
            <span>📚</span> Banco de Questões
          </button>
          <button class="nav-item" data-section="relatorios">
            <span>📄</span> Relatórios
          </button>
        </nav>

        <div class="profile-card">
          <label for="studentNameInput">Nome do aluno</label>
          <input id="studentNameInput" type="text" maxlength="40" placeholder="Digite seu nome" />
          <button id="saveStudentName" class="secondary-btn">Salvar perfil</button>
        </div>
      </aside>

      <main class="main-panel">
        <header class="topbar">
          <div>
            <p class="eyebrow">Aprenda Matemática com a IA MARQIV</p>
            <h2>MARQIV</h2>
          </div>

          <div class="topbar-actions">
            <button id="themeToggle" class="theme-toggle" aria-label="Alternar tema">🌙</button>
          </div>
        </header>

        <section id="home" class="content-section active">
          <div class="hero-card">
            <div class="hero-copy">
              <p class="badge">Slogan</p>
              <h3>Aprenda Matemática com Inteligência Artificial</h3>
              <p>
                Explore porcentagem, desafios práticos e um ambiente de estudo personalizado com a IA MARQIV.
              </p>
              <div class="cta-row">
                <button class="primary-btn" data-target="quiz">Iniciar Estudo</button>
                <button class="secondary-btn" data-target="quiz">Fazer Quiz</button>
                <button class="secondary-btn" data-target="dashboard">Ver Desempenho</button>
                <button class="secondary-btn" data-target="questions">Banco de Questões</button>
                <a class="external-link" href="https://github.com/henrique432433/edumind-ia" target="_blank" rel="noopener noreferrer">Ver repositório</a>
              </div>
            </div>
            <div class="hero-visual">
              <div class="mini-card accent">
                <span>🎯</span>
                <strong>Objetivo do dia</strong>
                <small>Resolver 3 exercícios de porcentagem</small>
              </div>
              <div class="mini-card">
                <span>⚡</span>
                <strong>Progresso</strong>
                <small id="homeProgressText">0% concluído</small>
              </div>
            </div>
          </div>

          <div class="info-grid">
            <article class="info-card">
              <span class="icon">🤖</span>
              <h4>Chat inteligente</h4>
              <p>Explicações guiadas, dicas de estudo e resolução passo a passo com a MARQIV.</p>
            </article>
            <article class="info-card">
              <span class="icon">📈</span>
              <h4>Gamificação</h4>
              <p>Conquiste pontos, suba de nível e acompanhe seu avanço.</p>
            </article>
            <article class="info-card">
              <span class="icon">🧪</span>
              <h4>Quiz adaptativo</h4>
              <p>Questões por nível de dificuldade e feedback imediato.</p>
            </article>
          </div>
        </section>

        <section id="chat" class="content-section">
          <div class="section-header">
            <h3>Chat Inteligente</h3>
          </div>

          <div class="chat-panel">
            <div id="chatMessages" class="chat-messages" aria-live="polite"></div>

            <div class="chat-suggestions" id="chatSuggestions"></div>

            <form id="chatForm" class="chat-form">
              <input
                id="chatInput"
                type="text"
                maxlength="250"
                placeholder="Pergunte sobre porcentagem, descontos ou juros..."
                aria-label="Pergunta do aluno"
              />
              <button type="submit" class="primary-btn">Enviar</button>
            </form>
          </div>
        </section>

        <section id="quiz" class="content-section">
          <div class="section-header">
            <h3>Quiz Inteligente</h3>
          </div>

          <div class="quiz-wrapper">
            <div class="quiz-card">
              <div class="quiz-meta">
                <span id="quizDifficulty" class="quiz-pill">Fácil</span>
                <span id="quizCategory" class="quiz-pill muted">Categoria</span>
              </div>
              <h4 id="quizQuestion">Carregando questão...</h4>
              <div id="quizOptions" class="quiz-options"></div>
              <div id="quizFeedback" class="quiz-feedback"></div>
              <button id="nextQuestionBtn" class="primary-btn hidden">Próxima questão</button>
            </div>
          </div>
        </section>

        <section id="dashboard" class="content-section">
          <div class="section-header">
            <h3>Dashboard</h3>
          </div>

          <div class="stats-grid">
            <div class="stat-card">
              <span>Pontuação</span>
              <strong id="scoreValue">0</strong>
            </div>
            <div class="stat-card">
              <span>Acertos</span>
              <strong id="hitsValue">0</strong>
            </div>
            <div class="stat-card">
              <span>Erros</span>
              <strong id="missesValue">0</strong>
            </div>
            <div class="stat-card">
              <span>Aproveitamento</span>
              <strong id="successRateValue">0%</strong>
            </div>
            <div class="stat-card">
              <span>Nível</span>
              <strong id="levelValue">Iniciante</strong>
            </div>
            <div class="stat-card">
              <span>Questões resolvidas</span>
              <strong id="answeredValue">0</strong>
            </div>
          </div>

          <div class="progress-panel">
            <div class="progress-row">
              <label>Progresso de nível</label>
              <span id="progressLabel">0%</span>
            </div>
            <div class="progress-bar">
              <div id="progressBar" class="progress-fill"></div>
            </div>
          </div>

          <div class="dashboard-charts">
            <div class="chart-card">
              <canvas id="resultsChart"></canvas>
            </div>
            <div class="chart-card">
              <canvas id="categoryChart"></canvas>
            </div>
          </div>

          <div id="recommendationBox" class="recommendation-box"></div>
        </section>

        <section id="planner" class="content-section">
          <div class="section-header">
            <h3>Meu Plano de Estudos</h3>
          </div>

          <div class="planner-grid">
            <div class="planner-card">
              <label for="weeklyGoal">Meta semanal</label>
              <input id="weeklyGoal" type="number" min="1" max="100" value="5" />
              <label for="monthlyGoal">Meta mensal</label>
              <input id="monthlyGoal" type="number" min="1" max="500" value="20" />
              <button id="saveGoalsBtn" class="primary-btn">Salvar metas</button>
            </div>

            <div class="planner-card">
              <div class="progress-row">
                <label>Meta semanal</label>
                <span id="weeklyProgressText">0/5</span>
              </div>
              <div class="progress-bar compact">
                <div id="weeklyProgressBar" class="progress-fill blue"></div>
              </div>

              <div class="progress-row">
                <label>Meta mensal</label>
                <span id="monthlyProgressText">0/20</span>
              </div>
              <div class="progress-bar compact">
                <div id="monthlyProgressBar" class="progress-fill purple"></div>
              </div>
            </div>
          </div>
        </section>

        <section id="questions" class="content-section">
          <div class="section-header">
            <h3>Banco de Questões</h3>
          </div>

          <div class="filters-row">
            <select id="categoryFilter">
              <option value="all">Todas as categorias</option>
              <option value="Conceitos Básicos">Conceitos Básicos</option>
              <option value="Descontos">Descontos</option>
              <option value="Aumentos">Aumentos</option>
              <option value="Juros Simples">Juros Simples</option>
              <option value="Problemas do Cotidiano">Problemas do Cotidiano</option>
            </select>
            <select id="difficultyFilter">
              <option value="all">Todas as dificuldades</option>
              <option value="Fácil">Fácil</option>
              <option value="Médio">Médio</option>
              <option value="Difícil">Difícil</option>
            </select>
          </div>

          <div id="questionsList" class="questions-list"></div>
        </section>

        <section id="relatorios" class="content-section">
          <div class="section-header">
            <h3>Relatórios</h3>
          </div>

          <div class="report-box">
            <p>Gerar relatório do rendimento do aluno em PDF ou TXT.</p>
            <div class="report-actions">
              <button id="exportPdfBtn" class="primary-btn">Gerar PDF</button>
              <button id="exportTxtBtn" class="secondary-btn">Gerar TXT</button>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script src="script.js"></script>
  </body>
</html>

																																																																																																																																																																																																																																																																																																																																																																																																			